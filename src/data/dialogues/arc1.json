      },
      "e_token": {
        "id": "e_token",
        "speaker": "Anciã Hexágono",
        "text": "Disseram-me que encontraste as três anomalias. A fonte escolheu-te.",
        "mood": "thinking",
        "next": "e_token__2"
      },
      "e_give": {
        "id": "e_give",
