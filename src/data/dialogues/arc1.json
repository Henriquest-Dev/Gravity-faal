      "e_after": {
        "id": "e_after",
        "speaker": "Anciã Hexágono",
        "text": "O observatório espera-te a norte da praça. Ele tem paciência. Eu já não tanta.",
        "mood": "neutral"
      },
      "e1__2": {
        "id": "e1__2",
        "speaker": "Anciã Hexágono",
        "text": "Primeiro aprende a ver o que a praça esconde. Depois falamos do céu.",
        "mood": "thinking"
      },
      "e_token__2": {
        "id": "e_token__2",
        "speaker": "Anciã Hexágono",
        "text": "Diz-me, criança: o que vês quando fechas o olho?",
        "mood": "neutral",
