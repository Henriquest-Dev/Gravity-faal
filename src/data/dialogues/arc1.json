    "nodes": {
      "p1": {
        "id": "p1",
        "speaker": "Professor Círculo",
        "text": "Bill! Outra vez a olhar para o sol de olho fechado?",
        "mood": "surprised",
        "next": "p1__2"
      },
      "p2": {
        "id": "p2",
        "speaker": "Professor Círculo",
        "text": "Hum. Formas que tremem... Há um texto antigo sobre isso. Diz que a fonte de cristal reage a quem vê demasiado.",
        "effects": [
          {
            "setFlag": "talked_professor"
          }
        ],
        "mood": "thinking",
        "next": "p2__2"
      },
      "p2b": {
        "id": "p2b",
        "speaker": "Professor Círculo",
        "text": "Está bem. Mas se um dia vires, vai à fonte. O cristal não mente, mesmo quando nós mentimos.",
        "effects": [
          {
            "setFlag": "talked_professor"
          }
        ],
        "mood": "neutral"
      },
      "p_hint": {
        "id": "p_hint",
        "speaker": "Professor Círculo",
        "text": "Três pontos da praça parecem-me... tortos. Um junto à casa a noroeste, outro no extremo leste, outro do outro lado do rio.",
        "mood": "thinking",
        "next": "p_hint__2"
      },
      "p_reported": {
        "id": "p_reported",
        "speaker": "Professor Círculo",
        "text": "Uma porta no céu. E alguém do outro lado.",
        "mood": "surprised",
        "next": "p_reported__2"
      },
      "p_default": {
        "id": "p_default",
        "speaker": "Professor Círculo",
        "text": "Um círculo não tem princípio nem fim, Bill. As melhores perguntas também não.",
        "mood": "happy"
      },
      "p1__2": {
        "id": "p1__2",
        "speaker": "Professor Círculo",
        "text": "Os teus colegas andam a dizer que vês «arestas a mais» nas coisas. Que tal me contares tu, em vez deles?",
        "mood": "thinking",
        "choices": [
          {
            "text": "Vejo coisas que não estão lá. Formas a tremer.",
            "tag": "Confiança",
            "effects": [
              {
                "var": "trust",
                "add": 1
              }
            ],
            "next": "p2"
          },
          {
            "text": "Não vejo nada, professor. Eles inventam.",
            "tag": "Esconder",
            "effects": [
              {
                "setFlag": "hid_from_professor"
              }
            ],
            "next": "p2b"
          }
        ]
      },
      "p2__2": {
        "id": "p2__2",
        "speaker": "Professor Círculo",
        "text": "Vai tocar-lhe. E depois volta e conta-me tudo, com os ângulos todos.",
        "mood": "happy"
      },
      "p_hint__2": {
        "id": "p_hint__2",
        "speaker": "Professor Círculo",
        "text": "Fecha um pouco esse teu olho e olha com o outro lado dele.",
        "mood": "neutral"
      },
      "p_reported__2": {
        "id": "p_reported__2",
        "speaker": "Professor Círculo",
        "text": "Vou estudar isto com todo o cuidado. Obrigado por confiares em mim, Bill. Nem toda a gente confiaria.",
        "mood": "thinking"
      }
    }
  },
