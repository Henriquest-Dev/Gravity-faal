      },
      "r1__2": {
        "id": "r1__2",
        "speaker": "Anciã Hexágono",
        "text": "Há gente presa: o Professor, o Mercador, a Tri. E a fenda... a fenda chama por ti. Ouço-a dizer o teu nome.",
