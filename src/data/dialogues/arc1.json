        "id": "m1",
        "speaker": "Mercador Quadrado",
        "text": "Tu! As minhas caixas mudaram de sítio sozinhas quando passaste.",
        "mood": "angry",
        "next": "m1__2"
      },
      "m_honest": {
        "id": "m_honest",
        "speaker": "Mercador Quadrado",
        "text": "...Hum. Pelo menos és honesto, o que é mais do que diz metade desta praça.",
        "mood": "thinking",
        "next": "m_honest__2"
      },
      "m_lie": {
        "id": "m_lie",
        "speaker": "Mercador Quadrado",
        "text": "O vento. Pois. Nesta praça não sopra vento há dez anos.",
        "mood": "angry"
      },
      "m_scare": {
        "id": "m_scare",
        "speaker": "Mercador Quadrado",
        "text": "Afasta-te da minha banca!",
        "mood": "scared",
        "next": "m_scare__2"
      },
      "m_scared": {
        "id": "m_scared",
        "speaker": "Mercador Quadrado",
        "text": "Não tenho nada para ti. Não tenho nada para ninguém.",
        "mood": "scared"
      },
      "m_default": {
        "id": "m_default",
        "speaker": "Mercador Quadrado",
        "text": "Triângulos, quadrados, círculos... todos pagam o mesmo preço. É a única coisa justa nesta terra.",
        "mood": "neutral"
      },
      "m1__2": {
        "id": "m1__2",
        "speaker": "Mercador Quadrado",
        "text": "Uma andou meio metro. Caixas não andam. Isto é obra tua, não é?",
        "mood": "angry",
        "choices": [
          {
            "text": "Fui eu, sem querer. Vejo coisas... e às vezes elas mexem-se.",
            "tag": "Honestidade",
            "effects": [
              {
                "var": "trust",
                "add": 1
              },
              {
                "var": "empathy",
                "add": 1
              },
              {
                "setFlag": "merchant_resolved"
              }
            ],
            "next": "m_honest"
          },
          {
            "text": "Foi o vento. As caixas estão mal empilhadas.",
            "tag": "Mentir",
            "effects": [
              {
                "var": "ambition",
                "add": 1
              },
              {
                "var": "trust",
                "add": -1
              },
              {
                "setFlag": "merchant_resolved"
              }
            ],
            "next": "m_lie"
          },
          {
            "text": "(o olho brilha) Talvez. Queres ver o que mais consigo mexer?",
            "tag": "Usar poder",
            "effects": [
              {
                "var": "ambition",
                "add": 2
              },
              {
                "var": "empathy",
                "add": -1
              },
              {
                "setFlag": "scared_merchant"
              },
              {
                "setFlag": "merchant_resolved"
              }
            ],
            "next": "m_scare"
          }
        ]
      },
      "m_honest__2": {
        "id": "m_honest__2",
        "speaker": "Mercador Quadrado",
        "text": "Arruma-as tu, então. E ensina esse olho a pedir licença.",
        "mood": "neutral"
      },
      "m_scare__2": {
        "id": "m_scare__2",
        "speaker": "",
        "text": "O mercador recua, a tremer. À volta, as janelas fecham-se uma a uma."
      }
    }
